{
  "name": "einstein-phaser",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Phaser 3 + TypeScript port of EinsteinGame (replacing the pygame/pygbag web build).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx tools/smoke.ts",
    "tut-smoke": "tsx tools/tut-smoke.ts",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
